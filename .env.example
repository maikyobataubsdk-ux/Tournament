# Environment Configuration for Booyahesports
# Domain: Booyahesports.in

# Primary Domain
DOMAIN=Booyahesports.in

# Base URLs (dynamic, do not hardcode in frontend)
PUBLIC_BASE_URL=https://Booyahesports.in
API_BASE_URL=https://Booyahesports.in/api
ADMIN_BASE_URL=https://Booyahesports.in/admin
DOWNLOAD_BASE_URL=https://Booyahesports.in/download

# Security & Secrets
JWT_SECRET=replace_with_a_secure_random_64_char_string_for_production
ADMIN_EMAIL=admin@booyahesports.in
ADMIN_INITIAL_PASSWORD=12345678

# Persistent Storage Directories
DATA_DIR=/app/data
RELEASES_DIR=/app/releases
UPLOADS_DIR=/app/uploads

# Cloudflare Configuration
# Set to 'dns' for Cloudflare DNS A/CNAME record proxy, or 'tunnel' for Cloudflare Tunnel
CLOUDFLARE_METHOD=dns
CLOUDFLARE_TUNNEL_TOKEN=
